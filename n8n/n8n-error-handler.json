{"active":false,"connections":{"Error Trigger":{"main":[[{"index":0,"node":"Format Alert","type":"main"}]]},"Format Alert":{"main":[[{"index":0,"node":"Slack Alert","type":"main"}],[{"index":0,"node":"Email Alert","type":"main"}]]}},"name":"Global Error Handler (Template)","nodes":[{"id":"e1e1e1e1-f2f2-a3a3-b4b4-c5c6d7e8f9a0","name":"Error Trigger","parameters":{},"position":[240,300],"type":"n8n-nodes-base.errorTrigger","typeVersion":1},{"id":"f2f2f2f2-a3a3-b4b4-c5c5-d6e7f8a9b0c1","name":"Setup Notes","parameters":{"color":3,"content":"## How to use\n1. Import this workflow, add your Slack + Gmail credentials.\n2. On EVERY other workflow: Settings → Error Workflow → select this one.\n3. Test: temporarily break a node (bad API key) and run — you should get the alert in under a minute.\n\nInternational standard: no client automation ships without a failure path.","height":280,"width":440},"position":[200,80],"type":"n8n-nodes-base.stickyNote","typeVersion":1},{"id":"a3a3a3a3-b4b4-c5c5-d6d6-e7f8a9b0c1d2","name":"Format Alert","parameters":{"jsCode":"const e = $input.first().json;\nreturn [{ json: {\n  workflow: e.execution?.workflowData?.name || 'unknown workflow',\n  failedNode: e.execution?.lastNodeExecuted || 'unknown node',\n  errorMessage: (e.execution?.error?.message || 'no message').substring(0, 500),\n  time: new Date().toISOString(),\n  executionUrl: `${$env.N8N_HOST}/workflow/${e.execution?.workflowData?.id}/executions/${e.execution?.id}`\n}}];"},"position":[480,300],"type":"n8n-nodes-base.code","typeVersion":2},{"credentials":{"slackApi":{"id":"REPLACE_WITH_SLACK_CRED_ID","name":"Slack account"}},"id":"b4b4b4b4-c5c5-d6d6-e7e7-f8a9b0c1d2e3","name":"Slack Alert","parameters":{"channel":"={{ $env.SLACK_CHANNEL || '#alerts' }}","otherOptions":{},"text":":rotating_light: AUTOMATION FAILED\\nWorkflow: {{ $json.workflow }}\\nNode: {{ $json.failedNode }}\\nError: {{ $json.errorMessage }}\\nTime: {{ $json.time }}\\n{{ $json.executionUrl }}"},"position":[720,200],"type":"n8n-nodes-base.slack","typeVersion":2.2},{"credentials":{"gmailOAuth2":{"id":"REPLACE_WITH_GMAIL_CRED_ID","name":"Gmail account"}},"id":"c5c5c5c5-d6d6-e7e7-f8f8-a9b0c1d2e3f4","name":"Email Alert","parameters":{"emailType":"text","message":"Automation failure detected.\\n\\nWorkflow: {{ $json.workflow }}\\nFailed node: {{ $json.failedNode }}\\nError: {{ $json.errorMessage }}\\nTime: {{ $json.time }}\\n\\nOpen: {{ $json.executionUrl }}","options":{},"sendTo":"={{ $env.OWNER_EMAIL }}","subject":"=:rotating_light: Automation failed: {{ $json.workflow }}"},"position":[720,400],"type":"n8n-nodes-base.gmail","typeVersion":2.1}],"pinData":{},"settings":{"executionOrder":"v1"}}